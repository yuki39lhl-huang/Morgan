# Clash 原始代理日志归档（单文件可达数百 MB，超出 GitHub 单文件 100MB 限制，无法推送）
logs/clash/archive/

# ─── 敏感文件：密钥/token/凭证一律不进仓库（2026-09-14 加入，防泄露） ───
credentials/feishu-default-allowFrom.json
credentials/feishu-pairing.json
crypto/.env
gateway.env
identity/device-auth.json
identity/device.json
workspace/IDENTITY.md
workspace/scripts/.feishu_token_cache.json
workspace/scripts/secrets.json

# Python 编译缓存
__pycache__/
*.pyc

# ─── 备份策略：仓库只保留代码+配置，以下为运行时日志/数据（2026-08-04 起） ───

# 日志（保留 README 说明）
logs/*
!logs/README.md
workspace/logs/

