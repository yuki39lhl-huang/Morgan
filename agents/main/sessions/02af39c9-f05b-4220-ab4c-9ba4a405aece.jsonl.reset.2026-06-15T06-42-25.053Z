T', 'startTime': int(datetime(2026,5,1).timestamp()*1000), 'limit': 50}\ntrades = bat.request('GET', '/fapi/v1/userTrades', params=params)\nif isinstance(trades, list):\n    trades.sort(key=lambda t: t.get('time', 0))\n    if trades:\n        first = datetime.fromtimestamp(trades[0]['time']/1000)\n        last = datetime.fromtimestamp(trades[-1]['time']/1000)\n        print(f'最早: {first.strftime(\\\"%Y-%m-%d %H:%M\\\")}')\n        print(f'最晚: {last.strftime(\\\"%Y-%m-%d %H:%M\\\")}')\n        print(f'BTC 共 {len(trades)} 笔')\n    else:\n        print('no BTC trades')\nelse:\n    print('API error:', trades)\n\" 2>&1","timeout":30}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":85,"output":1210,"cacheRead":24320,"cacheWrite":0,"totalTokens":25615,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1781427753371}}
