{"type":"message","id":"dac1b945","parentId":"6f1c2dd9","timestamp":"2026-05-26T23:25:52.331Z","message":{"role":"toolResult","toolCallId":"call_00_3pQAwaa1zmNDgv5TTo5G8245","toolName":"exec","content":[{"type":"text","text":"def format_price(price):\n    \"\"\"格式化价格到正确的精度\"\"\"\n    if price >= 1000:\n        return round(price, 2)\n    elif price >= 100:\n        return round(price, 2)\n    elif price >= 10:\n        return round(price, 2)\n    elif price >= 1:\n        return round(price, 2)\n    elif price >= 0.1:\n        return round(price, 4)\n    elif price >= 0.01:\n        return round(price, 5)\n    else:\n        return round(price, 6)\n\ndef set_isolated_margin(symbol):\n    \"\"\"\n    设置逐仓模式 (ISOLATED)\n    2026-03-28 老公指示：全仓→逐仓，精准控制风险\n    \"\"\"\n    timestamp = int(time.time() * 1000)\n    params = {\n        \"symbol\": symbol,\n        \"marginType\": \"ISOLATED\",\n        \"timestamp\": timestamp,\n        \"recvWindow\": 30000\n    }\n    query_string = '&'.join([f\"{k}={v}\" for k, v in params.items()])\n    signature = get_signature(query_string)"}],"details":{"status":"completed","exitCode":0,"durationMs":118,"aggregated":"def format_price(price):\n    \"\"\"格式化价格到正确的精度\"\"\"\n    if price >= 1000:\n        return round(price, 2)\n    elif price >= 100:\n        return round(price, 2)\n    elif price >= 10:\n        return round(price, 2)\n    elif price >= 1:\n        return round(price, 2)\n    elif price >= 0.1:\n        return round(price, 4)\n    elif price >= 0.01:\n        return round(price, 5)\n    else:\n        return round(price, 6)\n\ndef set_isolated_margin(symbol):\n    \"\"\"\n    设置逐仓模式 (ISOLATED)\n    2026-03-28 老公指示：全仓→逐仓，精准控制风险\n    \"\"\"\n    timestamp = int(time.time() * 1000)\n    params = {\n        \"symbol\": symbol,\n        \"marginType\": \"ISOLATED\",\n        \"timestamp\": timestamp,\n        \"recvWindow\": 30000\n    }\n    query_string = '&'.join([f\"{k}={v}\" for k, v in params.items()])\n    signature = get_signature(query_string)","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1779837952307}}
