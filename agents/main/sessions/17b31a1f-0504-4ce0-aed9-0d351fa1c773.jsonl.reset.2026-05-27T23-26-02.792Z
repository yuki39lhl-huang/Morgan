{"type":"message","id":"42b5ba27","parentId":"a65734ea","timestamp":"2026-05-27T16:09:15.528Z","message":{"role":"toolResult","toolCallId":"call_00_ET_3hz8eSVOWS9djwqIDJaf8097","toolName":"read","content":[{"type":"text","text":"def close_all_positions():\n    \"\"\"\n    平仓所有持仓（爆仓保护用）\n    \"\"\"\n    positions = get_all_positions()\n    for pos in positions:\n        try:\n            symbol = pos['symbol']\n            amt = float(pos.get('amount', 0))\n            if amt != 0:\n                side = 'SELL' if amt > 0 else 'BUY'\n                qty = abs(amt)\n                place_order(symbol, side, qty, reduce_only=True)\n                log.info(f\"✅ 爆仓保护平仓 {symbol} {side} {qty}\")\n        except Exception as e:\n            log.error(f\"❌ 爆仓保护平仓失败 {symbol}: {e}\")\n\ndef cancel_algo_orders(symbol: str):\n    \"\"\"取消某币种全部 Algo 条件单（TP/SL）\"\"\"\n    return request(\"DELETE\", \"/fapi/v1/algoOpenOrders\", {\"symbol\": symbol})\n\n\ndef place_algo_conditional_order(\n    symbol: str,\n    side: str,\n    order_type: str,\n    trigger_price,\n    working_type: str = \"MARK_PRICE\",\n):\n    \"\"\"\n    币安 USD-M 条件单（2025-12 起须走 Algo API，否则 -4120）\n\n    order_type: STOP_MARKET（止损）| TAKE_PROFIT_MARKET（止盈）\n    side: 平仓方向 — 平多 SELL，平空 BUY\n    \"\"\"\n    params = {\n        \"algoType\": \"CONDITIONAL\",\n        \"symbol\": symbol,\n        \"side\": side,\n        \"type\": order_type,\n        \"triggerPrice\": format_price(trigger_price),\n        \"closePosition\": \"true\",\n        \"workingType\": working_type,\n    }\n    return request(\"POST\", \"/fapi/v1/algoOrder\", params)\n\n\ndef check_margin_ratio_protection():\n    \"\"\"\n    爆仓保护检查\n\n[191 more lines in file. Use offset=394 to continue.]"}],"isError":false,"timestamp":1779898155502}}
