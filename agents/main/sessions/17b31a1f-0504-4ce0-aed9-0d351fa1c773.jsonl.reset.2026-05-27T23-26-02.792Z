n', '')\n            })\n        \n        log(f\"✅ CoinGecko 抓取成功：{len(news_items)} 条\")\n        return news_items\n        \n    except Exception as e:\n        log(f\"❌ CoinGecko 抓取失败：{e}\")\n        return []"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":92,"output":574,"cacheRead":95232,"cacheWrite":0,"totalTokens":95898,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779854894736}}
