{"type":"message","id":"753c1237","parentId":"d55eddd1","timestamp":"2026-06-03T00:34:41.306Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me fix submit_initial_algo_orders.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_00_8LuvkfrO14slrXap1JRe5479","name":"edit","arguments":{"file_path":"~/.openclaw/workspace/scripts/crypto_signal_monitor.py","new_string":"def submit_initial_algo_orders(pos: dict):\n    \"\"\"\n    为从 API 同步/方向反转后的持仓提交初始止盈止损 Algo 单。\n    2026-06-03 修复：精准替换，不碰另一边\n    \"\"\"\n    if not AUTO_TRADE_ENABLED:\n        return\n    try:\n        sym = pos[\"symbol\"]\n        typ = pos[\"type\"]\n        sl_price = pos.get(\"sl_price\")\n        tp_price = pos.get(\"tp1_price\")\n        if not sl_price or not tp_price:\n            return\n\n        sym_usdt = f\"{sym}USDT\"\n        # 只取消止损单，不动止盈\n        _cancel_algo_by_type(sym_usdt, \"STOP_MARKET\")\n\n        # 提交止损\n        sl_side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n        sl_result = place_algo_conditional_order(sym_usdt, sl_side, \"STOP_MARKET\", sl_price)\n        if isinstance(sl_result, dict) and sl_result.get(\"algoId\"):\n            log.info(f\"📌 {sym} 止损 Algo 单已提交：{sl_price} algoId={sl_result.get('algoId')}\")\n        else:\n            log.warning(f\"⚠️ {sym} 止损 Algo 单提交失败：{sl_result}\")\n\n        # 只取消止盈单，不动止损\n        _cancel_algo_by_type(sym_usdt, \"TAKE_PROFIT_MARKET\")\n        tp_side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n        tp_result = place_algo_conditional_order(sym_usdt, tp_side, \"TAKE_PROFIT_MARKET\", tp_price)\n        if isinstance(tp_result, dict) and tp_result.get(\"algoId\"):\n            log.info(f\"📌 {sym} 止盈 Algo 单已提交：{tp_price} algoId={tp_result.get('algoId')}\")\n        else:\n            log.warning(f\"⚠️ {sym} 止盈 Algo 单提交失败：{tp_result}\")\n    except Exception as e:\n        log.warning(f\"⚠️ {sym} 提交初始 Algo 单异常：{e}\")","old_string":"def submit_initial_algo_orders(pos: dict):\n    \"\"\"\n    为从 API 同步/方向反转后的持仓提交初始止盈止损 Algo 单。\n    取消该币种所有旧 Algo 单，然后提交新的 STOP_MARKET 和 TAKE_PROFIT_MARKET。\n    \"\"\"\n    if not AUTO_TRADE_ENABLED:\n        return\n    try:\n        sym = pos[\"symbol\"]\n        typ = pos[\"type\"]\n        sl_price = pos.get(\"sl_price\")\n        tp_price = pos.get(\"tp1_price\")\n        if not sl_price or not tp_price:\n            return\n\n        sym_usdt = f\"{sym}USDT\"\n        # 先取消该币种所有旧 Algo 单（止损/止盈都清）\n        cancel_algo_orders(sym_usdt)\n\n        # 提交止损\n        sl_side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n        sl_result = place_algo_conditional_order(sym_usdt, sl_side, \"STOP_MARKET\", sl_price)\n        if isinstance(sl_result, dict) and sl_result.get(\"algoId\"):\n            log.info(f\"📌 {sym} 止损 Algo 单已提交：{sl_price} algoId={sl_result.get('algoId')}\")\n        else:\n            log.warning(f\"⚠️ {sym} 止损 Algo 单提交失败：{sl_result}\")\n\n        # 提交止盈\n        tp_side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n        tp_result = place_algo_conditional_order(sym_usdt, tp_side, \"TAKE_PROFIT_MARKET\", tp_price)\n        if isinstance(tp_result, dict) and tp_result.get(\"algoId\"):\n            log.info(f\"📌 {sym} 止盈 Algo 单已提交：{tp_price} algoId={tp_result.get('algoId')}\")\n        else:\n            log.warning(f\"⚠️ {sym} 止盈 Algo 单提交失败：{tp_result}\")\n    except Exception as e:\n        log.warning(f\"⚠️ {sym} 提交初始 Algo 单异常：{e}\")"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":3374,"output":1098,"cacheRead":66560,"cacheWrite":0,"totalTokens":71032,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780446869082}}
