t}\")\n+1261                         if close_result.get('success', True):\n+1262                             break\n+1263                     except Exception as me:\n+1264                         log.error(f\"❌ 补充保证金失败：{me}\")\n+1265                 \n+1266                 log.warning(f\"⚠️ 平仓第{attempt+1}次失败，{'重试' if attempt < 4 else '放弃'}\")\n 1252                 if attempt < 4:\n 1253                     time.sleep(2)\n 1254             except Exception as e:\n 1255                 log.error(f\"❌ 平仓异常第{attempt+1}次：{e}\")\n      ...","firstChangedLine":1211},"isError":false,"timestamp":1780457406060}}
