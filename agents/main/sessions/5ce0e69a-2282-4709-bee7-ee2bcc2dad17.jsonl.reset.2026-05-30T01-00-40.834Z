{"type":"message","id":"cb434c1e","parentId":"2339c6b3","timestamp":"2026-05-29T13:18:43.671Z","message":{"role":"toolResult","toolCallId":"call_00_HRqUHgUKc7QNRZ17b7jN7886","toolName":"read","content":[{"type":"text","text":"                                log.info(f\"⚠️ {sym} 已有持仓，跳过轮换\")\n                                continue\n                            # 找最低评分的持仓\n                            weakest = None\n                            weakest_score = 999\n                            for pos in positions:\n                                if pos.get(\"is_closed\"):\n                                    continue\n                                psym = pos[\"symbol\"]\n                                if not indicators.get(psym) or not prices.get(psym):\n                                    continue\n                                pind = indicators[psym]\n                                ppd = prices[psym]\n                                preg = detect_regime(pind)\n                                psc, pdir = calc_score(\n                                    psym, ppd, pind, preg, fg_cache, fr_cache.get(psym, 0), btc_ind\n                                )\n                                if psc < weakest_score:\n                                    weakest_score = psc\n                                    weakest = pos\n                            if weakest is None:\n                                log.info(f\"⚠️ {sym} 已达最大持仓，无有效持仓可评估轮换\")\n                                continue\n                            if weakest.get(\"symbol\") == sym:\n                                log.info(f\"⚠️ {sym} 已有持仓，跳过自替换\")\n                                continue\n                            if new_score >= weakest_score + 20:\n                                log.info(f\"🔄 仓位轮换：{sym} {new_dir}({new_score}分) 替换 {weakest['symbol']}({weakest_score}分)\")\n                                try:\n                                    close_result = close_position(\n                       