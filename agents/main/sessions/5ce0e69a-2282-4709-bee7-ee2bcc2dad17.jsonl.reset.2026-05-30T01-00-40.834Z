realized={rpnl:.4f}\\\")\nif not recent:\n    print('今日暂无成交')\n    print('\\\\n最近成交记录:')\n    for t in trades[-10:]:\n        dt = datetime.fromtimestamp(t['time']/1000, tz).strftime('%m-%d %H:%M:%S')\n        rpnl = float(t.get('realizedPnl', 0))\n        print(f\\\"  [{dt}] {t['symbol']} {t.get('side','?')} qty={t.get('qty')} @ {t.get('price')} realized={rpnl:.4f}\\\")\nprint(f'\\\\n今日已实现总计: {total:.4f} USDT')\n\" 2>&1","timeout":30}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":365,"output":794,"cacheRead":30464,"cacheWrite":0,"totalTokens":31623,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780010005647}}
