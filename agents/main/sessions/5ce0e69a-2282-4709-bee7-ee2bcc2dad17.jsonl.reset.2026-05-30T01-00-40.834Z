{"type":"message","id":"73e11ce0","parentId":"cad145e1","timestamp":"2026-05-29T13:36:55.579Z","message":{"role":"toolResult","toolCallId":"call_00_ptJF9Hn2OTwkhZoEbEnj0072","toolName":"read","content":[{"type":"text","text":"                    for sym in CONFIG[\"symbols\"]:\n                        is_full = actual_count + opened_this_loop >= CONFIG[\"max_positions\"]\n                        # 满仓时尝试仓位轮换：新信号比最低持仓高 20 分则换仓\n                        if is_full:\n                            # 先拿到新信号的评分，才能决策是否换仓\n                            if not indicators.get(sym) or not prices.get(sym):\n                                continue\n                            if not news_filter.check_suspend(sym):\n                                continue\n                            ind_i = indicators[sym]\n                            pd_i = prices[sym]\n                            regime_i = detect_regime(ind_i)\n                            fr_i = fr_cache.get(sym, 0)\n                            new_score, new_dir = calc_score(\n                                sym, pd_i, ind_i, regime_i, fg_cache, fr_i, btc_ind\n                            )\n                            new_threshold = CONFIG[\"score_threshold\"][regime_i] + CONFIG[\"score_threshold\"].get(\"per_symbol_bonus\", {}).get(sym, 0)\n                            if new_dir == \"NONE\" or new_score < new_threshold:\n                                continue\n                            if not cooldown_manager.can_open(sym, new_dir):\n                                continue\n                            # 新信号币种已在持仓中，轮换无效\n                            sym_in_positions = any(p.get(\"symbol\") == sym and not p.get(\"is_closed\") for p in positions)\n                            if sym_in_positions:\n                                log.info(f\"⚠️ {sym} 已有持仓，跳过轮换\")\n                                continue\n                            # 找最低评分的持仓（跳过持仓不足10分钟的新仓，防止频繁换手）\n                            weakest = None\n                            weakest_score = 999\n                            from datetime import datetime as _dt\n                            now_ts = time.time()\n                            for pos in positions:\n                                if pos.get(\"is_closed\"):\n                                    continue\n                                psym = pos[\"symbol\"]\n                                # 新仓保护：持仓不足 10 分钟不参与轮换\n                                et = pos.get(\"entry_time\", \"\")\n                                if et:\n                                    try:\n                                        et_ts = _dt.fromisoformat(str(et)).timestamp()\n                                        if now_ts - et_ts < 600:\n                                            log.info(f\"🛡️ {psym} 持仓仅 {int(now_ts - et_ts)}s，跳过轮换（最小600s）\")\n                                            continue\n                                    except Exception:\n                                        pass\n                                if not indicators.get(psym) or not prices.get(psym):\n                                    continue\n                                pind = indicators[psym]\n                                ppd = prices[psym]\n                                preg = detect_regime(pind)\n                                psc, pdir = calc_score(\n                                    psym, ppd, pind, preg, fg_cache, fr_cache.get(psym, 0), btc_ind\n                                )\n                                if psc < weakest_score:\n                                    weakest_score = psc\n                                    weakest = pos\n                            if weakest is None:\n                                log.info(f\"⚠️ {sym} 已达最大持仓，无有效持仓可评估轮换\")\n                                continue\n                            if weakest.get(\"symbol\") == sym:\n                                log.info(f\"⚠️ {sym} 已有持仓，跳过自替换\")\n                                continue\n                            if new_score >= weakest_score + 20:\n                                log.info(f\"🔄 仓位轮换：{sym} {new_dir}({new_score}分) 替换 {weakest['symbol']}({weakest_score}分)\")\n                                try:\n                                    close_result = close_position(\n                                        weakest,\n                                        f\"轮换替换（{sym}信号{new_score}分 > {weakest['symbol']}{weakest_score}分+20）\",\n                                        1.0,\n                                        prices.get(weakest[\"symbol\"], {}).get(\"price\", 0),\n                                    )\n                                    # close_position 返回 float(PnL)，异常表明失败\n                                    if isinstance(close_result, (int, float)):\n                                        positions = [p for p in positions if p[\"symbol\"] != weakest[\"symbol\"]]\n                                        save_positions(positions)\n                                        log.info(f\"✅ 轮换平仓 {weakest['symbol']} 成功，准备开 {sym}\")\n                                        # 不手动加 opened_this_loop，后续正常开仓会自己加\n                                        # 只更新 positions，is_full 下次循环自动校准\n                                    else:\n                                        log.warning(f\"⚠️ 轮换平仓 {weakest['symbol']} 失败（返回值异常），跳过\")\n                                        continue\n                                except Exception as re:\n                                    log.warning(f\"⚠️ 轮换异常：{re}\")\n                                    continue\n                            else:\n                                log.info(f\"⚠️ {sym} 已达最大持仓，轮换不达标 (新{new_score} vs 最弱{weakest_score}，需≥{weakest_score+20})\")\n                                continue\n\n                        ind    = indicators[sym]\n                        pd     = prices[sym]\n                        regime = detect_regime(ind)\n                        fr     = fr_cache.get(sym, 0)\n\n                        score, direction = calc_score(\n                            sym, pd, ind, regime, fg_cache, fr, btc_ind\n                        )\n\n                        if direction == \"NONE\":\n                            continue\n                        if not cooldown_manager.can_open(sym, direction):\n\n[146 more lines in file. Use offset=2456 to continue.]"}],"isError":false,"timestamp":1780061815568}}
