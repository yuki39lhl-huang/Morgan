r.can_open(sym, new_dir):\n                                continue\n                            # 找最低评分的持仓\n                            weakest = None\n                            weakest_score = 999\n                            for pos in positions:\n                                if pos.get(\"is_closed\"):\n                                    continue\n                                psym = pos[\"symbol\"]\n                                if not indicators.get(psym) or not prices.get(psym):\n                                    continue\n                                pind = indicators[psym]\n                                ppd = prices[psym]\n                                preg = detect_regime(pind)\n                                psc, pdir = calc_score(\n                                    psym, ppd, pind, preg, fg_cache, fr_cache.get(psym, 0), btc_ind\n                                )\n                                if psc < weakest_score:\n                                    weakest_score = psc\n                                    weakest = pos\n                            if weakest and new_score >= weakest_score + 20:\n                                log.info(f\"🔄 仓位轮换：{sym} {new_dir}({new_score}分) 替换 {weakest['symbol']}({weakest_score}分)\")\n                                try:\n                                    close_result = close_position(\n                                        weakest[\"symbol\"], weakest[\"type\"],\n                                        reason=f\"轮换替换（{sym}信号{new_score}分 > {weakest['symbol']}{weakest_score}分+20）\"\n                                    )\n                                    if close_result and close_result.get(\"success\"):\n                                        positions = [p for p in positions if p[\"symbol\"] != weakest[\"symbol\"]]\n                                        save_positions(positions)\n                                        opened_this_loop += 1\n                                        actual_count -= 1\n                                        log.info(f\"✅ 轮换平仓 {weakest['symbol']} 成功，准备开 {sym}\")\n                                    else:\n                                        log.warning(f\"⚠️ 轮换平仓 {weakest['symbol']} 失败，跳过\")\n                                        continue\n                                except Exception as re:\n                                    log.warning(f\"⚠️ 轮换异常：{re}\")\n                                    continue\n                            else:\n                                log.info(f\"⚠️ {sym} 已达最大持仓，轮换不达标 (新{new_score} vs 最弱{weakest_score}，需≥{weakest_score+20})\")\n                                continue","old_string":"                    for sym in CONFIG[\"symbols\"]:\n                        # 检查是否已满仓（包含本循环已开的仓位）\n                        if actual_count + opened_this_loop >= CONFIG[\"max_positions\"]:\n                            log.info(f\"⚠️ {sym} 已达最大持仓数，跳过开仓\")\n                            break\n                        if not indicators.get(sym) or not prices.get(sym):\n                            continue\n                        if not news_filter.check_suspend(sym):\n                            continue"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":258,"output":1083,"cacheRead":109568,"cacheWrite":0,"totalTokens":110909,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780046392916}}
