oday_start.timestamp() * 1000)\n    if isinstance(trades, list):\n        recent = [t for t in trades if t.get('time',0) >= today_ts]\n        print(f'今日成交 {len(recent)} 笔:')\n        total_pnl = 0\n        for t in recent:\n            dt = datetime.fromtimestamp(t['time']/1000, tz).strftime('%H:%M:%S')\n            rpnl = float(t.get('realizedPnl', 0))\n            total_pnl += rpnl\n            print(f\\\"  {dt} {t['symbol']} {t.get('side','')} qty={t.get('qty')} price={t.get('price')} pnl={rpnl:.4f}\\\")\n        print(f'总计: {total_pnl:.4f}')\n    else:\n        print(f'API返回: {trades}')\nexcept Exception as e:\n    print(f'Error: {e}')\n\" 2>&1","timeout":30}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":125,"output":1050,"cacheRead":28544,"cacheWrite":0,"totalTokens":29719,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780009974188}}
