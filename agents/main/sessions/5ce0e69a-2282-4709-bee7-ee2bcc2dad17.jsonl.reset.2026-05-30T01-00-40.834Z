{"type":"message","id":"cd9ad3d5","parentId":"e2096702","timestamp":"2026-05-29T09:14:55.265Z","message":{"role":"toolResult","toolCallId":"call_00_7y0T23Cui6eo9IZX2qz04032","toolName":"exec","content":[{"type":"text","text":"98:    # 信号冷却\n99:    \"signal_cooldown\": {\n143:# AI 浮亏触发冷却（放在主循环外面）\n144:ai_loss_cooldown = {}  # symbol → 上次触发时间\n818:# 九、信号冷却\n832:        # 同向冷却\n834:        if elapsed < CONFIG[\"signal_cooldown\"][\"same_direction\"]:\n835:            log.info(f\"⏳ {symbol} {direction} 冷却中，还需 {int(CONFIG['signal_cooldown']['same_direction']-elapsed)}秒\")\n845:        \"\"\"平仓后清除该币种所有方向的冷却（让下次开仓不被卡）\"\"\"\n1217:        # ✅ 平仓后清除该币种冷却，让下次开仓不被卡 5 分钟\n1219:            global cooldown_manager\n1220:            if cooldown_manager and size_ratio >= 1.0:\n1221:                cooldown_manager.reset_after_close(symbol)\n1222:                log.info(f\"🔄 {symbol} 平仓后已清除冷却记录\")\n1224:            log.warning(f\"清除冷却异常: {e}\")\n1457:    global cooldown_manager\n1462:        if not immediate and cooldown_manager:\n1463:            cooldown_manager.add_push_signal(symbol, signal)\n1466:        pass  # cooldown_manager 未初始化，直接推送\n2033:    global cooldown_manager"}],"details":{"status":"completed","exitCode":0,"durationMs":152,"aggregated":"98:    # 信号冷却\n99:    \"signal_cooldown\": {\n143:# AI 浮亏触发冷却（放在主循环外面）\n144:ai_loss_cooldown = {}  # symbol → 上次触发时间\n818:# 九、信号冷却\n832:        # 同向冷却\n834:        if elapsed < CONFIG[\"signal_cooldown\"][\"same_direction\"]:\n835:            log.info(f\"⏳ {symbol} {direction} 冷却中，还需 {int(CONFIG['signal_cooldown']['same_direction']-elapsed)}秒\")\n845:        \"\"\"平仓后清除该币种所有方向的冷却（让下次开仓不被卡）\"\"\"\n1217:        # ✅ 平仓后清除该币种冷却，让下次开仓不被卡 5 分钟\n1219:            global cooldown_manager\n1220:            if cooldown_manager and size_ratio >= 1.0:\n1221:                cooldown_manager.reset_after_close(symbol)\n1222:                log.info(f\"🔄 {symbol} 平仓后已清除冷却记录\")\n1224:            log.warning(f\"清除冷却异常: {e}\")\n1457:    global cooldow