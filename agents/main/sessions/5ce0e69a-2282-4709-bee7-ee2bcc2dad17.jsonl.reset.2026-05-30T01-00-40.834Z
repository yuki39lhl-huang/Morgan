hreshold = CONFIG[\"score_threshold\"][regime_i] + CONFIG[\"score_threshold\"].get(\"per_symbol_bonus\", {}).get(sym, 0)\n+                            if new_dir == \"NONE\" or new_score < new_threshold:\n+                                continue\n+                            if not cooldown_manager.can_open(sym, new_dir):\n+                                continue\n+                            # 新信号币种已在持仓中，轮换无效\n+                            sym_in_positions = any(p.get(\"symbol\") == sym and not p.get(\"is_closed\") for p in positions)\n+                            if sym_in_positions:\n+                                log.info(f\"⚠️ {sym} 已有持仓，跳过轮换\")\n+                                continue\n+                            # 找最低评分的持仓（跳过持仓不足10分钟的新仓，防止频繁换手）\n+                            weakest = None\n+                            weakest_score = 999"}],"details":{"status":"completed","exitCode":0,"durationMs":321,"aggregated":"--- a/workspace/scripts/crypto_signal_monitor.py\n+++ b/workspace/scripts/crypto_signal_monitor.py\n@@ -70,6 +70,10 @@ CONFIG = {\n+        # 单币阈值加成：等于提高开仓门槛\n+        \"per_symbol_bonus\": {\n+            \"SOL\": 10,           # SOL 历史胜率低，多要10分\n+        },\n@@ -99,6 +103,10 @@ CONFIG = {\n+        # 单币冷却覆盖（秒），SOL 高频低胜率，拉长冷却\n+        \"per_symbol\": {\n+            \"SOL\": 600,           # 10分钟\n+        },\n@@ -551,6 +559,8 @@ def calc_score(\n+    # 单币阈值加成：低胜率币种提高门槛\n+    threshold += CONFIG[\"score_threshold\"].get(\"per_symbol_bonus\", {}).get(symbol, 0)\n@@ -829,10 +839,13 @@ class CooldownManager:\n-        # 同向冷却\n+        # 同向冷却（优先用单币覆盖，否则默认）\n+        cooldown_sec = CONFIG[\"signal_cooldown\"].get(\"per_symbol\", {}).get(\n+            symbol, CONFIG[\"signal_cooldown\"][\"same_direction\"]\n+        )\n-        if elapsed < CONFIG[\"signal_cooldown\"][\"same_direction\"]:\n-            log.info(f\"⏳ {symbol} {direction} 冷却中，还需 {int(CONFIG['signal_cooldown']['same_direction']-elapsed)}秒\")\n+        if elapsed < cooldown_sec:\n+ 