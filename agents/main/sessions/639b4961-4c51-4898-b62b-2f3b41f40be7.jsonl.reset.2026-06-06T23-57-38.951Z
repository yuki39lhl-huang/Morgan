       # 只取消止损单，不动止盈\n750:            log.info(f\"📌 {symbol} 止损 Algo 单已更新：{old_sl:.4f} → {new_sl:.4f}\")\n752:            log.warning(f\"⚠️ {symbol} 更新 Binance 止损单失败：{sl_result}\")\n754:        # 同时更新止盈（如果有变更，只取消止盈不动止损）\n757:            _cancel_algo_by_type(sym_usdt, \"TAKE_PROFIT_MARKET\")\n759:                sym_usdt, tp_side, \"TAKE_PROFIT_MARKET\", tp_price, quantity=qty\n762:                log.info(f\"📌 {symbol} 止盈 Algo 单已恢复：{tp_price}\")\n764:                log.warning(f\"⚠️ {symbol} 恢复 Binance 止盈单失败：{tp_result}\")\n766:        log.warning(f\"⚠️ {symbol} 同步止损/止盈单异常：{e}\")\n770:    为从 API 同步/方向反转后的持仓提交初始止盈止损 Algo 单。"}],"details":{"status":"completed","exitCode":0,"durationMs":99,"aggregated":"5:优化：WebSocket实时价格 + 分层扫描 + 市场状态识别 + 移动止盈 + 熔断保护\n79:    # 基础止盈止损（ATR动态覆盖）\n83:    # 移动止盈 - 2026-03-30 老公指示：关闭移动止盈，严格固定 -2% 止损\n84:    # 2026-03-30 老公指示：三档移动止盈（回撤比例）\n91:    # ATR止损倍数分层\n93:        (0.02, 1.0),   # ATR% < 2%  →  止损1.0倍ATR\n94:        (0.04, 1.5),   # ATR% < 4%  →  止损1.5倍ATR\n95:        (9999, 2.0),   # ATR% >= 4% →  止损2.0倍ATR\n581:    2026-06-03 老公指示：止损改为 ATR 动态 + 2% 保底\n582:    - 止盈：+4%（TP1 全平 100%）\n583:    - 止损：max(2%, ATR% × 分层倍数)，防止止损价被行情轻易打穿\n587:    TAKE_PROFIT_PCT = 0.04  # 2026-03-30 老公指示：改回 4%（8U）\n590:    # ── ATR 动态止损距离 ──\n602:        tp1 = entry * (1 + TAKE_PROFIT_PCT)\n605:        tp1 = entry * (1 - TAKE_PROFIT_PCT)\n611:        \"peak_pnl\":  0.0,   # 移动止盈用\n616:# 七、止盈止损检查（15秒必跑，极轻量）\n635:        # 跳过止盈止损为 0 的无效持仓\n637:            log.warning(f\"⚠️ {sym} 止盈止损无效 (TP1={tp1}, SL={sl})，跳过检查\")\n658:    移动止盈 - 2026-03-30 老公指示：三档移动止盈（从峰值价回撤）\n697:            # 同步到 Binance（取消旧单 + 提交新止损+止盈）\n698:            sync_stop_loss_to_binance(sym, typ, pos[\"sl_price\"], old_sl, pos.get(\"tp1_price\", 0), qty=abs(pos.get(\"amount\", 0)))\n710:                # 同步到 Binance（取消旧单 + 提交新止损+止盈）\n711:                sync_stop_loss_to_binance(sym, typ, pos[\"sl_price\"], old_sl, pos.get(\"tp1_price\", 0), qty=abs(pos.get(\"amount\", 0)))\n717:                # 同步