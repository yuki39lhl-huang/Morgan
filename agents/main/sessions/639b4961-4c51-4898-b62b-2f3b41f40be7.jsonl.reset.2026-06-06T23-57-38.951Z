{"type":"message","id":"f9563ec1","parentId":"ce979c7a","timestamp":"2026-06-06T05:42:16.213Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_00_ET_QGqp40ylGWHrhqP8lMvn6587","name":"exec","arguments":{"command":"cd /root/.openclaw/workspace/scripts && python3 -c \"\nimport sys\nsys.path.insert(0, '.')\nfrom crypto_signal_monitor import calc_tp_sl\n\n# 全部测试\ntests = [\n    ('ATR=1% 保底', 0.01, 0.04),\n    ('ATR=2% 保底', 0.02, 0.04),\n    ('ATR=3% 动态', 0.03, 0.06),\n    ('ATR=5% 动态', 0.05, 0.10),\n    ('ATR=8% 上限', 0.08, 0.15),\n    ('ATR=12% 上限', 0.12, 0.15),\n    ('无ind兼容', None, 0.04),\n]\n\nall_ok = True\nfor label, atr, expected_tp in tests:\n    ind = {'atr_pct': atr} if atr is not None else {}\n    r = calc_tp_sl(100.0, 'LONG', ind, {})\n    passed = abs(r['tp_pct'] - expected_tp) < 0.01\n    ok = '✅' if passed else '❌'\n    if not passed:\n        all_ok = False\n        print(f'{ok} {label}: tp_pct={r[\\\"tp_pct\\\"]}, expected={expected_tp}')\n    else:\n        print(f'{ok} {label}: tp_pct={r[\\\"tp_pct\\\"]:.2f} tp={r[\\\"tp1_price\\\"]:.1f} sl={r[\\\"sl_price\\\"]:.1f}')\n\n# SHORT 方向\nr = calc_tp_sl(100.0, 'SHORT', {'atr_pct': 0.05}, {})\nassert r['tp1_price'] < 100.0 < r['sl_price'], 'SHORT 方向错'\nprint(f'✅ SHORT: tp={r[\\\"tp1_price\\\"]:.1f} sl={r[\\\"sl_price\\\"]:.1f}')\n\nprint(f'\\\\n{\\\"🎉 全部通过\\\" if all_ok else \\\"❌ 有失败\\\"}')\n\" 2>&1"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":67,"output":543,"cacheRead":110848,"cacheWrite":0,"totalTokens":111458,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780724527330}}
