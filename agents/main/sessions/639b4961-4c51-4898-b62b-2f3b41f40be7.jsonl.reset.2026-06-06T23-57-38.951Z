G[\\\"trailing_tiers\\\"]}')\n\" 2>&1"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":137,"output":749,"cacheRead":61056,"cacheWrite":0,"totalTokens":61942,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780725057352}}
