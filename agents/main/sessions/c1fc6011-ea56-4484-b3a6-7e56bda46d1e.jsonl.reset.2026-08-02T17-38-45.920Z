         del_result = request(\"DELETE\", \"/fapi/v1/algoOrder\", {\"algoId\": algo_id})\n449:    return request(\"POST\", \"/fapi/v1/algoOrder\", params)\n494:        leverage_result = request(\"POST\", \"/fapi/v1/leverage\", {\n510:    order_result = request(\"POST\", \"/fapi/v1/order\", order_params)\n607:    regular_result = request(\"DELETE\", \"/fapi/v1/allOpenOrders\", {\"symbol\": sym_usdt})\n614:    result = request(\"GET\", \"/fapi/v1/time\")","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1784825024862}}
