{"type":"message","id":"11f1450c","parentId":"b75c7720","timestamp":"2026-06-02T00:05:38.448Z","message":{"role":"toolResult","toolCallId":"call_00_TmG7PGZ5Q3dEvY5snqrz1183","toolName":"exec","content":[{"type":"text","text":"41:        place_order,\n68:    # 开仓阈值（按市场状态分层）\n73:        # 单币阈值加成：等于提高开仓门槛\n858:        \"\"\"平仓后清除该币种所有方向的冷却（让下次开仓不被卡）\"\"\"\n895:        # 分离开仓和平仓信号\n899:        # 优先显示开仓，其次平仓\n1025:def open_position(\n1034:    # 2026-04-27 老公指示：下单前最后一道闸门 —— Binance API 实时确认无同币种持仓\n1035:    # 防止多进程/race condition 重复开仓（之前 12 秒内开 2 次 XRP / SSL EOF 后又开一次 BNB 都是这个 bug）\n1039:            log.warning(f\"🚫 {symbol} 下单闸门：API 已有持仓，拒绝重复下单\")\n1044:                \"order_result\": {\"success\": False, \"message\": \"API 已有持仓，拒绝重复下单\"},\n1050:        log.warning(f\"⚠️ 下单闸门查持仓异常：{_e}（继续走流程）\")\n1064:            # 调用 binance_auto_trade 模块下单\n1066:            order_result = place_order(\n1076:            log.info(f\"📝 下单结果：{order_result}\")\n1078:            log.error(f\"❌ 下单失败：{e}\")\n1098:    # 检查订单是否真正成功（默认 False，强制要求 place_order 显式返回 success=True）\n1110:        msg += f\" | ❌ 下单失败：{err_msg}\"\n1111:        # 立即推送下单失败告警到飞书（不走缓冲，老公需要立刻知道）\n1114:                f\"🚨 {symbol} 下单失败 - 信号未执行\",\n1122:                        f\"⚠️ **币安实际未下单**，请检查 API key / 余额 / 网络\"\n1132:        msg += f\" | ✅ 下单成功\"\n1168:    # 实盘平仓调用（使用 place_order with reduce_only=True）\n1176:                close_result = place_order(\n1184:                log.info(f\"📝 平仓结果：{close_result}\")\n1230:        # ✅ 平仓后清除该币种冷却，让下次开仓不被卡 5 分钟\n1469:    \"\"\"推送交易信号告警（开仓/平仓）- 支持缓冲合并\"\"\"\n1521:        content += f\"**💰 开仓价：** ${price:,.4f}\\n\"\n1770:            f\"**{symbol}** {pos_type} | 开仓：${entry_price:,.2f} | \"\n1771:            f\"现价：${display_price:,.2f} | 开仓评分：{open_score} | \""}],"details":{"status":"completed","exitCode":0,"durationMs":133,"aggregated":"41:        place_order,\n68:    # 开仓阈值（按市场状态分层）\n73:        # 单币阈值加成：等于提高开仓门槛\n858:        \"\"\"平仓后清除该币种所有方向的冷却（让下次开仓不被卡）\"\"\"\n895:        # 分离开