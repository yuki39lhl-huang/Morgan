{"type":"message","id":"e6dd78df","parentId":"36be9668","timestamp":"2026-06-09T13:02:48.072Z","message":{"role":"toolResult","toolCallId":"call_00_TB7BfhCcQcnFY64QzeMB8720","toolName":"exec","content":[{"type":"text","text":"\"score_threshold\": {\n        \"trending\":  70,\n        \"ranging\":   55,  # 震荡市要求更高确认度，避免假突破\n        \"volatile\":  90,\n        # 单币阈值加成：等于提高开仓门槛\n        \"per_symbol_bonus\": {\n            \"SOL\": 10,           # SOL 历史胜率低，多要10分\n        },\n    },\n\n    # 基础止盈止损（ATR动态覆盖）\n--\n    threshold = CONFIG[\"score_threshold\"][regime]\n    # 单币阈值加成：低胜率币种提高门槛\n    threshold += CONFIG[\"score_threshold\"].get(\"per_symbol_bonus\", {}).get(symbol, 0)\n    if long_score > short_score and long_score >= threshold:\n        return long_score, \"LONG\"\n    elif short_score > long_score and short_score >= threshold:\n        return short_score, \"SHORT\""}],"details":{"status":"completed","exitCode":0,"durationMs":83,"aggregated":"\"score_threshold\": {\n        \"trending\":  70,\n        \"ranging\":   55,  # 震荡市要求更高确认度，避免假突破\n        \"volatile\":  90,\n        # 单币阈值加成：等于提高开仓门槛\n        \"per_symbol_bonus\": {\n            \"SOL\": 10,           # SOL 历史胜率低，多要10分\n        },\n    },\n\n    # 基础止盈止损（ATR动态覆盖）\n--\n    threshold = CONFIG[\"score_threshold\"][regime]\n    # 单币阈值加成：低胜率币种提高门槛\n    threshold += CONFIG[\"score_threshold\"].get(\"per_symbol_bonus\", {}).get(symbol, 0)\n    if long_score > short_score and long_score >= threshold:\n        return long_score, \"LONG\"\n    elif short_score > long_score and short_score >= threshold:\n        return short_score, \"SHORT\"","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1781010168065}}
