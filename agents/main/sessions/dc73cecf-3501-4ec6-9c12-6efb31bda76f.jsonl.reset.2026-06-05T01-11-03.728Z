=current_price)\n1289:                                        leverage=10, reduce_only=False, price=current_price,\n1841:        amount = position_amount(pos)  # 本地缓存数量（可能已被反转重建修正）\n2109:        amt = position_amount(pos)\n2393:                pnl = close_position(pos, reason, size, p)","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1780545233198}}
{"type":"message","id":"16da0aba","parentId":"8e59e409","timestamp":"2026-06-04T03:53:55.820Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Let me read the close_position function to see how it determines the close quantity:","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_00_BOVhjUCH4CM1wwRXJ9XN1425","name":"read","arguments":{"file_path":"/root/.openclaw/workspace/scripts/crypto_signal_monitor.py","limit":100,"offset":1200}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":312,"output":126,"cacheRead":86656,"cacheWrite":0,"totalTokens":87094,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780545233220}}
{"type":"message","id":"19bfe773","parentId":"16da0aba","timestamp":"2026-06-04T03:53:55.923Z","message":{"role":"toolResult","toolCallId":"call_00_BOVhjUCH4CM1wwRXJ9XN1425","toolName":"read","content":[{"type":"text","text":"def close_position(pos: dict, reason: str, size_ratio: float, current_price: float):\n    entry = pos[\"entry_price\"]\n    typ   = pos[\"type\"]\n    symbol = pos[\"symbol\"]\n    qty_raw = pos.get(\"qty\", 0) * size_ratio\n    \n    qty = format_quantity(symbol, qty_raw, entry)\n\n    # 实盘平仓调用（使用 place_order with reduce_only=True）\n    # 2026-06-03 修复：币安测试网 reduceOnly 全线返回 -2022，降级为不带 reduceOnly 的平仓\n    close_result = None\n    margin_replenished = False  # 2026-06-03：-4164 保证金不足时只补一次\n    position_padded = False     # 2026-06-03：名义价值 < $20 时只补一次\n    if AUTO_TRADE_ENABLED and size_ratio > 0:\n        for attempt in range(5):\n            try:\n                side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n                sym_usdt = f\"{symbol}USDT\"\n                \n                # 🔧 2026-06-03：第一次用 reduceOnly；如果被拒（-2022）则降级不带 reduceOnly\n                close_result = place_order(\n                    symbol=sym_usdt,\n                    side=side,\n                    quantity=qty,\n                    leverage=10,\n                    reduce_only=(attempt == 0),\n                    price=current_price,\n                )\n                log.info(f\"📝 平仓结果：{close_result}\")\n                \n                if close_result.get('success', True):\n                    break\n                \n                order_code = close_result.get('order', {}).get('code', 0)\n                \n                # 降级1：reduceOnly 被拒 → 不带 reduceOnly\n                if attempt == 0 and order_code == -2022:\n                    log.warning(f\"⚠️ {symbol} reduceOnly 被币安拒（-2022），降级为普通平仓\")\n                    time.sleep(1)\n                    close_result = place_order(\n                        symbol=sym_usdt, side=side, quantity=qty,\n                        leverage=10, reduce_only=False, price=current_price,\n                    )\n                    log.info(f\"📝 平仓结果（降级）：{close_result}\")\n                    if close_result.get('success', True):\n                        break\n                    order_code = close_result.get('order', {}).get('code', 0)\n                \n                # 降级2：-4164 补充保证金\n                if order_code == -4164 and not margin_replenished:\n                    log.warning(f\"⚠️ {symbol} 保证金/名义价值不足（-4164），补充 5 USDT\")\n                    try:\n                        request(\"POST\", \"/fapi/v1/positionMargin\", {\n                            \"symbol\": sym_usdt, \"amount\": 5.0, \"type\": 1\n                        })\n                        margin_replenished = True\n                        time.sleep(1)\n                        close_result = place_order(\n                            symbol=sym_usdt, side=side, quantity=qty,\n                            leverage=10, reduce_only=False, price=current_price,\n                        )\n                        log.info(f\"📝 平仓结果（补保证金后）：{close_result}\")\n                        if close_result.get('success', True):\n                            break\n                        order_code = close_result.get('order', {}).get('code', 0)\n                    except Exception as me:\n                        log.error(f\"❌ 补充保证金失败：{me}\")\n                \n                # 降级3：名义价值 < $20 → 买入≥$20 名义价值的量撑大后全平\n                if order_code == -4164 and not position_padded and current_price > 0:\n                    notional = qty * current_price\n                    if notional < 20:\n                        pad_qty = 20.0 / current_price  # 最少买入 $20 名义价值\n                        pad_qty = format_quantity(symbol, pad_qty, current_price)\n                        if pad_qty > 0:\n                            log.warning(f\"⚠️ {symbol} 名义 {notional:.1f} < $20，买入 {pad_qty} 撑大后全平\")\n                            try:\n                                pad_side = \"BUY\" if typ == \"LONG\" else \"SELL\"\n                                r = place_order(symbol=sym_usdt, side=pad_side, quantity=pad_qty,\n                                                leverage=10, reduce_only=False, price=current_price)\n                                if r.get('success', True):\n                                    position_padded = True\n                                    time.sleep(1)\n                                    # 平全部（原持仓 + 补仓量）\n                                    r_pos = request(\"GET\", \"/fapi/v2/positionRisk\", {\"symbol\": sym_usdt})\n                                    amt = abs(float(r_pos[0]['positionAmt'])) if isinstance(r_pos, list) and r_pos else qty\n                                    total_qty = format_quantity(symbol, amt, current_price) if amt > qty else qty\n                                    close_result = place_order(\n                                        symbol=sym_usdt, side=side, quantity=total_qty,\n                                        leverage=10, reduce_only=False, price=current_price,\n                                    )\n                                    log.info(f\"📝 平仓结果（撑大后）：{close_result}\")\n                                    if close_result.get('success', True):\n                                        break\n                            except Exception as pe:\n                                log.error(f\"❌ 加仓撑大失败：{pe}\")\n                \n                log.warning(f\"⚠️ 平仓第{attempt+1}次失败，{'重试' if attempt < 4 else '放弃'}\")\n                if attempt < 4:\n                    time.sleep(2)\n\n[1371 more lines in file. Use offset=1300 to continue.]"}],"isError":false,"timestamp":1780545235914}}
{"type":"message","id":"86b2e966","parentId":"19bfe773","timestamp":"2026-06-04T03:54:29.661Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"I see the core bug now. Line 1204:\n\n```python\nqty_raw = pos.get(\"qty\", 0) * size_ratio\nqty = format_quantity(symbol, qty_raw, entry)\n```\n\nThe close quantity is taken from `pos[\"qty\"]` which comes from the LOCAL CACHE. After 反转重建 fixes the local cache amount to, say, 25.23 (for LINK), the close tries to close 25.23 LINK. But the exchange only has 21.23. So:\n1. First attempt: reduce_only=True, 25.23 → fails (-2022, position is only 21.23)\n2. Fallback: reduce_only=False, 25.23 → opens a market order for 25.23 on the opposite side\n\nThe fix should be: use the ACTUAL API position amount for close, not the local cache amount.\n\nBut wait, there's also the \"降级3\" (degradation 3) at line 1279 which tries to read the actual position amount from the API:\n\n```python\nr_pos = request(\"GET\", \"/fapi/v2/positionRisk\", {\"symbol\": sym_usdt})\namt = abs(float(r_pos[0]['positionAmt'])) if isinstance(r_pos, list) and r_pos else qty\n```\n\nThis fallback only triggers when the error code is -4164 (insufficient margin). The -2022 error (reduce_only rejected) doesn't trigger this.\n\nSo the fix is:\n1. When -2022 is hit, the fallback should use the ACTUAL position amount from the API instead of the local cache amount. OR:\n2. The close_position function should use the API amount upfront.\n\nLet me think about the best fix:\n\nOption A: Before closing, query the API for the actual position amount, and use THAT instead of the local cache amount.\n\nOption B: In the -2022 handler, re-query the actual position and use that amount.\n\nOption C: Fix the position sync to update the local cache with the API amount.\n\nOption C is the cleanest. If the local cache always has the actual exchange amount, then close_position will always use the right amount.\n\nBut wait - if the local cache has the actual amount (21.23 for LINK, 11.7 for DOT), then the whole \"反转重建\" logic is WRONG. The 反转重建 is supposed to correct the amount to the risk-control standard. But it's causing more problems than it solves.\n\nThe fundamental issue: the code tries to maintain a \"standard\" position size in the local cache, but the exchange has a different amount. This mismatch causes close orders to use the wrong quantity.\n\nThe real fix: the local cache should always reflect the ACTUAL exchange position. The \"standardized\" amount should only be used for NEW position opens, not for position tracking.\n\nLet me fix the close_position function to use API amount:\n\n```python\ndef close_position(pos: dict, reason: str, size_ratio: float, current_price: float):\n    # Get actual position amount from API\n    from binance_auto_trade import get_all_positions\n    api_positions = get_all_positions()\n    actual_qty = pos.get(\"qty\", 0)\n    for ap in api_positions:\n        if ap.get(\"symbol\") == pos[\"symbol\"]:\n            actual_qty = abs(float(ap.get(\"amount\", 0) or 0))\n            break\n    \n    qty_raw = actual_qty * size_ratio\n    qty = format_quantity(symbol, qty_raw, entry)\n```\n\nBut this adds an API call to every close. That's OK since closes are infrequent.\n\nActually, a simpler approach: in the -2022 handler, query the API for the actual amount and retry.\n\nActually wait, the problem with my current approach (just using actual_qty from API) is that it still won't work correctly for the first attempt (reduce_only). Let me restructure:\n\n1. Always use API amount for close, not local cache\n2. Fall back to local cache amount if API fails\n\nLet me implement this.","thinkingSignature":"reasoning_content"},{"type":"text","text":"找到病因了。`close_position()` 第 1204 行用本地缓存的 `pos[\"qty\"]` 做平仓数量，反转重建把本地缓存改成了 25.23 LINK，但交易所实际只有 21.23，导致 reduce_only 被拒，降级后又开了 25.23 仓，净剩 4 LINK。\n\n改：平仓前从 API 取真实持仓数量，不用本地缓存。"},{"type":"toolCall","id":"call_00_xj0zixmXEN0h5BGwZ6rO8820","name":"edit","arguments":{"file_path":"/root/.openclaw/workspace/scripts/crypto_signal_monitor.py","old_string":"def close_position(pos: dict, reason: str, size_ratio: float, current_price: float):\n    entry = pos[\"entry_price\"]\n    typ   = pos[\"type\"]\n    symbol = pos[\"symbol\"]\n    qty_raw = pos.get(\"qty\", 0) * size_ratio\n    \n    qty = format_quantity(symbol, qty_raw, entry)\n\n    # 实盘平仓调用（使用 place_order with reduce_only=True）\n    # 2026-06-03 修复：币安测试网 reduceOnly 全线返回 -2022，降级为不带 reduceOnly 的平仓\n    close_result = None\n    margin_replenished = False  # 2026-06-03：-4164 保证金不足时只补一次\n    position_padded = False     # 2026-06-03：名义价值 < $20 时只补一次\n    if AUTO_TRADE_ENABLED and size_ratio > 0:\n        for attempt in range(5):\n            try:\n                side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n                sym_usdt = f\"{symbol}USDT\"\n                \n                # 🔧 2026-06-03：第一次用 reduceOnly；如果被拒（-2022）则降级不带 reduceOnly\n                close_result = place_order(\n                    symbol=sym_usdt,\n                    side=side,\n                    quantity=qty,\n                    leverage=10,\n                    reduce_only=(attempt == 0),\n                    price=current_price,\n                )\n                log.info(f\"📝 平仓结果：{close_result}\")\n                \n                if close_result.get('success', True):\n                    break\n                \n                order_code = close_result.get('order', {}).get('code', 0)\n                \n                # 降级1：reduceOnly 被拒 → 不带 reduceOnly\n                if attempt == 0 and order_code == -2022:\n                    log.warning(f\"⚠️ {symbol} reduceOnly 被币安拒（-2022），降级为普通平仓\")\n                    time.sleep(1)\n                    close_result = place_order(\n                        symbol=sym_usdt, side=side, quantity=qty,\n                        leverage=10, reduce_only=False, price=current_price,\n                    )\n                    log.info(f\"📝 平仓结果（降级）：{close_result}\")\n                    if close_result.get('success', True):\n                        break\n                    order_code = close_result.get('order', {}).get('code', 0)","new_string":"def close_position(pos: dict, reason: str, size_ratio: float, current_price: float):\n    entry = pos[\"entry_price\"]\n    typ   = pos[\"type\"]\n    symbol = pos[\"symbol\"]\n    sym_usdt = f\"{symbol}USDT\"\n\n    # 🐛 修复：从 API 取真实持仓数量，不用本地缓存\n    # 反转重建会把本地缓存改成风控标准量，但交易所实际量可能不同\n    # 用本地缓存的量会导致 reduceOnly 被拒（-2022），产生降级连锁反应\n    actual_qty = pos.get(\"qty\", 0)\n    try:\n        from binance_auto_trade import get_all_positions\n        for ap in (get_all_positions() or []):\n            if ap.get(\"symbol\") == symbol:\n                api_amt = abs(float(ap.get(\"amount\", 0) or 0))\n                if api_amt > 0:\n                    actual_qty = api_amt\n                    break\n    except Exception:\n        pass  # 降级使用本地缓存\n    \n    qty_raw = actual_qty * size_ratio\n    qty = format_quantity(symbol, qty_raw, entry)\n\n    # 实盘平仓调用（使用 place_order with reduce_only=True）\n    # 2026-06-03 修复：币安测试网 reduceOnly 全线返回 -2022，降级为不带 reduceOnly 的平仓\n    close_result = None\n    margin_replenished = False  # 2026-06-03：-4164 保证金不足时只补一次\n    position_padded = False     # 2026-06-03：名义价值 < $20 时只补一次\n    if AUTO_TRADE_ENABLED and size_ratio > 0:\n        for attempt in range(5):\n            try:\n                side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n                \n                # 🔧 2026-06-03：第一次用 reduceOnly；如果被拒（-2022）则降级不带 reduceOnly\n                close_result = place_order(\n                    symbol=sym_usdt,\n                    side=side,\n                    quantity=qty,\n                    leverage=10,\n                    reduce_only=(attempt == 0),\n                    price=current_price,\n                )\n                log.info(f\"📝 平仓结果：{close_result}\")\n                \n                if close_result.get('success', True):\n                    break\n                \n                order_code = close_result.get('order', {}).get('code', 0)\n                \n                # 降级1：reduceOnly 被拒 → 不带 reduceOnly\n                if attempt == 0 and order_code == -2022:\n                    log.warning(f\"⚠️ {symbol} reduceOnly 被币安拒（-2022），降级为普通平仓\")\n                    time.sleep(1)\n                    close_result = place_order(\n                        symbol=sym_usdt, side=side, quantity=qty,\n                        leverage=10, reduce_only=False, price=current_price,\n                    )\n                    log.info(f\"📝 平仓结果（降级）：{close_result}\")\n                    if close_result.get('success', True):\n                        break\n                    order_code = close_result.get('order', {}).get('code', 0)"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":1309,"output":3173,"cacheRead":87040,"cacheWrite":0,"totalTokens":91522,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780545235930}}
