{"type":"message","id":"f8d3a137","parentId":"c5083ab7","timestamp":"2026-06-04T12:05:04.080Z","message":{"role":"toolResult","toolCallId":"call_00_OZfkvO97HNJHHwC5fSza3682","toolName":"read","content":[{"type":"text","text":"                break\n\n        if not active_tier:\n            continue\n\n        # 4% 全平特殊处理\n        if active_tier.get(\"gap\", 0) >= 0.9:\n            old_sl = pos[\"sl_price\"]\n            pos[\"sl_price\"] = p * 0.999 if typ == \"LONG\" else p * 1.001\n            # 同步到 Binance（取消旧单 + 提交新止损+止盈）\n            sync_stop_loss_to_binance(sym, typ, pos[\"sl_price\"], old_sl, pos.get(\"tp1_price\", 0))\n            continue\n        \n        # 回撤比例（老公指示）- 从峰值价回撤！\n        gap = active_tier[\"gap\"]\n        peak_p = pos.get(\"peak_price\", entry)  # ✅ 用峰值价，不是当前价\n        \n        if typ == \"LONG\":\n            new_sl = peak_p * (1 - gap)  # 峰值价回撤 gap%\n            if new_sl > pos[\"sl_price\"]:\n                old_sl = pos[\"sl_price\"]\n                pos[\"sl_price\"] = round(new_sl, 4)\n                # 同步到 Binance（取消旧单 + 提交新止损+止盈）\n                sync_stop_loss_to_binance(sym, typ, pos[\"sl_price\"], old_sl, pos.get(\"tp1_price\", 0))\n        else:\n            new_sl = peak_p * (1 + gap)  # 峰值价回撤 gap%\n            if new_sl < pos[\"sl_price\"]:\n                old_sl = pos[\"sl_price\"]\n                pos[\"sl_price\"] = round(new_sl, 4)\n                # 同步到 Binance（取消旧单 + 提交新止损+止盈）\n                sync_stop_loss_to_binance(sym, typ, pos[\"sl_price\"], old_sl, pos.get(\"tp1_price\", 0))\n\ndef _cancel_algo_by_type(symbol_usdt: str, order_type: str):\n    \"\"\"取消某币种指定类型的 Algo 单（不影响另一边）\"\"\"\n    try:\n\n[1963 more lines in file. Use offset=723 to continue.]"}],"isError":false,"timestamp":1780574704068}}
