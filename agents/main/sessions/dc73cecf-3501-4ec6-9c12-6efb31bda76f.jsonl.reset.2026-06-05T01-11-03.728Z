{"type":"message","id":"5bf002f2","parentId":"9360015e","timestamp":"2026-06-04T12:04:18.235Z","message":{"role":"toolResult","toolCallId":"call_00_PNFVKvG27i8vxmabJrGS0849","toolName":"read","content":[{"type":"text","text":"def place_algo_conditional_order(\n    symbol: str,\n    side: str,\n    order_type: str,\n    trigger_price,\n    working_type: str = \"MARK_PRICE\",\n):\n    \"\"\"\n    币安 USD-M 条件单（2025-12 起须走 Algo API，否则 -4120）\n\n    order_type: STOP_MARKET（止损）| TAKE_PROFIT_MARKET（止盈）\n    side: 平仓方向 — 平多 SELL，平空 BUY\n    \"\"\"\n    params = {\n        \"algoType\": \"CONDITIONAL\",\n        \"symbol\": symbol,\n        \"side\": side,\n        \"type\": order_type,\n        \"triggerPrice\": format_price(trigger_price),\n        \"closePosition\": \"true\",\n        \"workingType\": working_type,\n    }\n    return request(\"POST\", \"/fapi/v1/algoOrder\", params)\n\n\ndef check_margin_ratio_protection():\n    \"\"\"\n    爆仓保护检查\n    保证金率低于 5% 立即平仓所有持仓\n    \"\"\"\n\n[188 more lines in file. Use offset=396 to continue.]"}],"isError":false,"timestamp":1780574658223}}
{"type":"message","id":"cb84f5aa","parentId":"5bf002f2","timestamp":"2026-06-04T12:04:18.253Z","message":{"role":"toolResult","toolCallId":"call_01_FlNw8QDbnBxfO2IrnUh12755","toolName":"read","content":[{"type":"text","text":"def submit_initial_algo_orders(pos: dict):\n    \"\"\"\n    为从 API 同步/方向反转后的持仓提交初始止盈止损 Algo 单。\n    2026-06-03 修复：精准替换，不碰另一边\n    \"\"\"\n    if not AUTO_TRADE_ENABLED:\n        return\n    try:\n        sym = pos[\"symbol\"]\n        typ = pos[\"type\"]\n        sl_price = pos.get(\"sl_price\")\n        tp_price = pos.get(\"tp1_price\")\n        if not sl_price or not tp_price:\n            return\n\n        sym_usdt = f\"{sym}USDT\"\n        # 只取消止损单，不动止盈\n        _cancel_algo_by_type(sym_usdt, \"STOP_MARKET\")\n\n        # 提交止损\n        sl_side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n        sl_result = place_algo_conditional_order(sym_usdt, sl_side, \"STOP_MARKET\", sl_price)\n        if isinstance(sl_result, dict) and sl_result.get(\"algoId\"):\n            log.info(f\"📌 {sym} 止损 Algo 单已提交：{sl_price} algoId={sl_result.get('algoId')}\")\n        else:\n            log.warning(f\"⚠️ {sym} 止损 Algo 单提交失败：{sl_result}\")\n\n        # 只取消止盈单，不动止损\n        _cancel_algo_by_type(sym_usdt, \"TAKE_PROFIT_MARKET\")\n        tp_side = \"SELL\" if typ == \"LONG\" else \"BUY\"\n        tp_result = place_algo_conditional_order(sym_usdt, tp_side, \"TAKE_PROFIT_MARKET\", tp_price)\n        if isinstance(tp_result, dict) and tp_result.get(\"algoId\"):\n            log.info(f\"📌 {sym} 止盈 Algo 单已提交：{tp_price} algoId={tp_result.get('algoId')}\")\n        else:\n            log.warning(f\"⚠️ {sym} 止盈 Algo 单提交失败：{tp_result}\")\n    except Exception as e:\n        log.warning(f\"⚠️ {sym} 提交初始 Algo 单异常：{e}\")\n\n# ═══════════════════════════════════════════════════════════════\n# 八、熔断器\n# ═══════════════════════════════════════════════════════════════\nclass CircuitBreaker:\n\n    def __init__(self):\n        self.daily_pnl   = 0.0\n        self.reset_date  = datetime.now().date()\n        self.paused_until: Optional[datetime] = None\n\n    def record_trade(self, pnl: float):\n        today = datetime.now().date()\n\n[1869 more lines in file. Use offset=817 to continue.]"}],"isError":false,"timestamp":1780574658241}}
