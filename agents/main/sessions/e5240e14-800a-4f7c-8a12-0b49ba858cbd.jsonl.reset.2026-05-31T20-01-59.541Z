d style.","thinkingSignature":"reasoning_content"},{"type":"text","text":"醒都醒了，还赖我呢 👑\n\n10点了老公，早餐吃了没？"}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":9472,"output":886,"cacheRead":10496,"cacheWrite":0,"totalTokens":20854,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1780192923206}}
