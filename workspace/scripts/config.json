    { "pnl_ratio": 0.50, "gap_ratio": 0.20 },
    { "pnl_ratio": 0.75, "gap_ratio": 0.25 },
    { "pnl_ratio": 1.00, "gap": 0.999 }
  ],

  "_atr_sl_tiers": "ATR 止损倍数分层：[ATR%上限, 止损倍数]",
