    "trending": 70,
    "ranging": 65,
    "volatile": 90,
    "per_symbol_bonus": { "SOL": 10 }
  },

  "base_tp_pct": 0.08,
  "base_sl_pct": 0.05,

  "_trailing_tiers": "移动止盈：达到止盈比例后按回撤比例平仓（2026-06-06 改相对止盈）",
